# LLM
LOCAL_LLM_PROVIDER=ollama
# Same PC as Ollama:
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# Laptop talking to the desktop (replace with the desktop IP):
# LOCAL_LLM_BASE_URL=http://192.168.1.101:11434
# On the desktop, Ollama must listen on the LAN. Run scripts/expose-ollama-lan.ps1 as admin.
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

LOCAL_LLM_CONNECT_TIMEOUT_SECONDS=2
LOCAL_LLM_REQUEST_TIMEOUT_SECONDS=45
LOCAL_LLM_MAX_RETRIES=0

LOCAL_LLM_CIRCUIT_BREAKER_FAILURES=2
LOCAL_LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# Workers
MAX_PARALLEL_WORKERS=4

# Security
SECURITY_MODE=READ_ONLY
ALLOWED_PATHS=
ENABLE_SHELL=false
ALLOWED_COMMANDS=

# Cache
CACHE_ENABLED=true
CACHE_TTL_DAYS=30
CACHE_MAX_SIZE_GB=10
CACHE_CLEANUP_THRESHOLD_PERCENT=90
CACHE_TARGET_USAGE_PERCENT=80
CACHE_CLEANUP_INTERVAL_HOURS=6

# Logs
LOG_RETENTION_DAYS=14
LOG_MAX_SIZE_MB=250

# Optional data home (default: ~/.local-worker-mcp)
# LOCAL_WORKER_HOME=
